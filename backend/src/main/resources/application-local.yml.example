# 复制为 application-local.yml（该文件已被 .gitignore 忽略，不会提交）
# application.yml 通过 spring.config.import 自动加载本文件，无需激活 local profile

spring:
  datasource:
    username: root
    password: your_password_here

jwt:
  secret: replace-with-a-long-random-secret-at-least-32
  expiration: 604800000

app:
  init-admin:
    enabled: true
